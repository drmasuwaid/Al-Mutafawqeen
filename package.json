{
  "name": "school-task-flow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev --port 43123 --hostname 0.0.0.0",
    "emulators": "npx firebase emulators:start --only auth,firestore,storage --project school-task-flow",
    "seed": "node scripts/seed.mjs",
    "seed:production": "node scripts/seed-production.mjs",
    "check:production": "node scripts/check-production-env.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "build": "next build",
    "start": "next start --port 43123 --hostname 0.0.0.0",
    "lint": "eslint",
    "test:assignments": "node --experimental-strip-types --import ./scripts/ts-test-register.mjs --test lib/teachers.grade-subjects.test.ts lib/teacher-records.grade-subjects.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase-admin": "^14.3.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "firebase-tools": "^15.28.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
