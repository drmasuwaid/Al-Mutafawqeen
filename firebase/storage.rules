rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Bytes live in Cloud Storage. The Next.js server uses the Admin SDK
    // (which bypasses these rules) so students still go through /api/attachments.
    match /homework/{homeworkId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
