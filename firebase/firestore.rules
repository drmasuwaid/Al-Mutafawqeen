rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && profile().role == 'admin';
    }
    function isTeacher() {
      return signedIn() && profile().role == 'teacher';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin() || request.auth.uid == uid;
    }

    match /teachers/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || request.auth.uid == id;
    }

    match /classes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /homework/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin() || (isTeacher() && (resource.data.createdBy == request.auth.uid || resource.data.teacherId == request.auth.uid));

      match /completions/{studentId} {
        allow read: if signedIn();
        allow write: if isAdmin() || isTeacher() || request.auth.uid == studentId;
      }
    }
  }
}
