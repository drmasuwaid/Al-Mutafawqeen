# Firebase project (production)
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=

# Service account JSON as a single line, or base64 of that JSON.
# Prefer a file path when seeding from your laptop.
# On Firebase App Hosting the Admin SDK can use Google default credentials
# instead of this JSON (same GCP project).
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
FIREBASE_SERVICE_ACCOUNT=

# Random string, 32+ characters. Example: openssl rand -base64 48
SESSION_SECRET=

# Optional: used only by `npm run seed:production` when no principal exists yet.
# PRINCIPAL_USERNAME=noura
# PRINCIPAL_EMAIL=noura.admin@mutafawqeen.school
# PRINCIPAL_PASSWORD=

# Leave these unset in production. They are set automatically by `npm run dev`.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8181
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
